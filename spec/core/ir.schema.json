{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/r-a-elu-architecture/RSOS-Language/spec/core/ir.schema.json",
 "title": "RSOS Core v1 IR",
 "description": "A program: an ordered list of operations, executed atomically (all or none). spec/core/STATE_OPS.md.",
 "type": "array",
 "minItems": 1,
 "items": {
  "oneOf": [
   {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "op",
     "key",
     "value"
    ],
    "properties": {
     "op": {
      "const": "set"
     },
     "key": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "value": {
      "type": "string"
     }
    }
   },
   {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "op",
     "key",
     "from"
    ],
    "properties": {
     "op": {
      "const": "copy"
     },
     "key": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "from": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     }
    }
   },
   {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "op",
     "key"
    ],
    "properties": {
     "op": {
      "const": "delete"
     },
     "key": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     }
    }
   },
   {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "op",
     "dst",
     "src"
    ],
    "properties": {
     "op": {
      "const": "derive"
     },
     "dst": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "src": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "add": {
      "type": "integer"
     },
     "max": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   },
   {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "op",
     "dst",
     "a",
     "b"
    ],
    "properties": {
     "op": {
      "const": "sum_into"
     },
     "dst": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "a": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "b": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "max": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   },
   {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "op",
     "key",
     "factor"
    ],
    "properties": {
     "op": {
      "const": "multiply"
     },
     "key": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "factor": {
      "type": "number",
      "minimum": 0
     },
     "max": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   },
   {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "op",
     "cond_key",
     "equals",
     "dst",
     "then",
     "else"
    ],
    "properties": {
     "op": {
      "const": "select_if"
     },
     "cond_key": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "equals": {
      "type": "string"
     },
     "dst": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[A-Za-z_][\\w-]*)+$"
     },
     "then": {
      "type": "string"
     },
     "else": {
      "type": "string"
     }
    }
   },
   {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "op",
     "field",
     "from",
     "to"
    ],
    "properties": {
     "op": {
      "const": "reassign_where"
     },
     "field": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w-]*$"
     },
     "from": {
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    }
   },
   {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "op",
     "field",
     "cond_field",
     "equals"
    ],
    "properties": {
     "op": {
      "const": "derive_where"
     },
     "field": {
      "type": "string"
     },
     "cond_field": {
      "type": "string"
     },
     "equals": {
      "type": "string"
     },
     "add": {
      "type": "integer"
     },
     "max": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   }
  ]
 }
}
